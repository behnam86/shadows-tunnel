[Unit]
Description=Shadows Tunnel Source Agent (Outbound WSS + TCP Multiplexing)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shadows
Group=shadows
ExecStart=/usr/local/bin/shadows agent -config /etc/shadows/agent.json
Restart=always
RestartSec=3s
StartLimitIntervalSec=60
StartLimitBurst=10
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/shadows
ReadWritePaths=/var/lib/shadows
LimitNOFILE=65536
UMask=0027

[Install]
WantedBy=multi-user.target
